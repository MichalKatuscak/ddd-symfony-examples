{% extends 'base.html.twig' %}
{% macro money(m) %}{{ (m.amountInCents / 100)|number_format(2, ',', ' ') }} {{ m.currency.value }}{% endmacro %}
{% block title %}Ukázka: Základní koncepty DDD{% endblock %}
{% block body %}
{% import _self as fmt %}
<div class="container mt-4">
    <div class="alert alert-info">
        Tato ukázka patří ke kapitole
        <a href="https://ddd-v-symfony.katuscak.cz/zakladni-koncepty"><strong>Základní koncepty DDD</strong></a>
    </div>
    <nav class="mb-3"><a href="{{ path('examples_index') }}">← Zpět na přehled</a></nav>
    <h1>Ukázka: Entity, hodnotové objekty, agregát</h1>
    <p>Objednávka jako agregát hlídá svá doménová pravidla. Každé porušení hlásí pojmenovaná výjimka.</p>

    {% if result %}<div class="alert alert-success">{{ result }}</div>{% endif %}
    {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

    <div class="row g-4">
        <div class="col-md-6">
            <h3>Order::addItem()</h3>
            <form method="post" data-turbo="false">
                <input type="hidden" name="action" value="add_item">
                <div class="mb-2"><input type="number" name="qty" value="2" min="1" class="form-control" placeholder="Množství"></div>
                <div class="mb-2"><input type="number" name="price" value="599" min="0" step="0.01" class="form-control" placeholder="Jednotková cena (CZK)"></div>
                <button class="btn btn-primary">Přidat položku</button>
            </form>
        </div>
        <div class="col-md-6">
            <h3>Doménová pravidla</h3>
            <form method="post" data-turbo="false" class="mb-2">
                <input type="hidden" name="action" value="confirm_with_item">
                <button class="btn btn-success w-100">Order::confirm() – úspěch</button>
            </form>
            <form method="post" data-turbo="false" class="mb-2">
                <input type="hidden" name="action" value="confirm_empty">
                <button class="btn btn-warning w-100">Order::confirm() na prázdné objednávce → EmptyOrderException</button>
            </form>
            <form method="post" data-turbo="false" class="mb-2">
                <input type="hidden" name="action" value="add_after_confirm">
                <button class="btn btn-warning w-100">addItem() po potvrzení → InvalidOrderStateTransitionException</button>
            </form>
        </div>
    </div>

    <hr class="my-5">
    <h2>Entita: rovnost podle identity</h2>
    <p>Tentýž uživatel načtený dvakrát, jedna instance mezitím změnila e-mail. Totožnost určuje jen <code>UserId</code>.</p>
    <table class="table table-sm w-auto">
        <tbody>
            <tr><th><code>$first-&gt;equals($second)</code></th><td>{{ entityDemo.sameIdentity ? 'true' : 'false' }}</td><td class="text-muted small">stejné ID → tatáž entita</td></tr>
            <tr><th><code>$first == $second</code></th><td>{{ entityDemo.looseEquality ? 'true' : 'false' }}</td><td class="text-muted small">srovnává všechny vlastnosti, e-mail se liší</td></tr>
            <tr><th><code>$first === $second</code></th><td>{{ entityDemo.strictIdentity ? 'true' : 'false' }}</td><td class="text-muted small">srovnává instance v paměti</td></tr>
        </tbody>
    </table>

    <hr class="my-5">
    <h2>Hodnotové objekty</h2>
    <p>Hodnotový objekt identifikuje sám sebe celou svou hodnotou. Je neměnný a formát hlídá konstruktor.</p>

    {% if voResult %}
        <div class="alert alert-success">
            {% if voResult.type == 'email' %}
                <code>Email::fromUserInput('{{ voResult.raw }}')</code> → <code>{{ voResult.value }}</code>
            {% else %}
                {{ fmt.money(voResult.a) }} + {{ fmt.money(voResult.b) }} = <strong>{{ fmt.money(voResult.sum) }}</strong>
                &nbsp;|&nbsp; Původní <code>$a</code> zůstal {{ fmt.money(voResult.a) }}.
            {% endif %}
        </div>
    {% endif %}
    {% if voError %}
        <div class="alert alert-danger">{{ voError }}</div>
    {% endif %}

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Email</strong> – konstruktor validuje, továrna normalizuje</div>
                <div class="card-body">
                    <form method="post" data-turbo="false">
                        <input type="hidden" name="action" value="vo_email">
                        <div class="mb-2">
                            <input type="text" name="email" value="  Jan.Novak@Example.com " class="form-control" placeholder="E-mailová adresa">
                        </div>
                        <button class="btn btn-primary">Email::fromUserInput($raw)</button>
                    </form>
                    <pre class="mt-3 bg-light p-2 rounded small">final readonly class Email
{
    public function __construct(public string $value)
    {
        if (!filter_var($value, FILTER_VALIDATE_EMAIL)) {
            throw new \InvalidArgumentException('Invalid email address');
        }
    }

    public static function fromUserInput(string $raw): self
    {
        return new self(mb_strtolower(trim($raw)));
    }
}</pre>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header"><strong>Money</strong> – částka v haléřích a měna jako enum</div>
                <div class="card-body">
                    <form method="post" data-turbo="false">
                        <input type="hidden" name="action" value="vo_money">
                        <div class="row g-2 mb-2">
                            <div class="col"><input type="number" name="amount_a" value="599" step="0.01" class="form-control" placeholder="Částka A (CZK)"></div>
                            <div class="col"><input type="number" name="amount_b" value="299" step="0.01" class="form-control" placeholder="Částka B"></div>
                            <div class="col-auto">
                                <select name="currency_b" class="form-select">
                                    <option value="CZK">CZK</option>
                                    <option value="EUR">EUR</option>
                                </select>
                            </div>
                        </div>
                        <button class="btn btn-primary">$a-&gt;add($b)</button>
                    </form>
                    <pre class="mt-3 bg-light p-2 rounded small">public function add(self $other): self
{
    if ($this-&gt;currency !== $other-&gt;currency) {
        throw new \DomainException(...); // pravidlo, ne formát
    }

    // vrací NOVÝ objekt, $this se nemění
    return new self(
        $this-&gt;amountInCents + $other-&gt;amountInCents,
        $this-&gt;currency,
    );
}</pre>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-5">
    <h2>Doménové události</h2>
    <p>Agregát událost zaznamená v doménové metodě voláním <code>record()</code>. Controller objednávku nejdřív uloží do repozitáře a teprve potom si události vyzvedne přes <code>releaseEvents()</code>.</p>

    {% if events %}
        <div class="card mb-3 border-warning">
            <div class="card-header bg-warning"><strong>Zaznamenané události</strong> (po poslední akci)</div>
            <ul class="list-group list-group-flush">
                {% for event in events %}
                <li class="list-group-item">
                    <span class="badge bg-warning text-dark me-2">{{ event.class }}</span>
                    <pre class="mt-1 mb-0 small bg-light p-1 rounded">{{ event.payload|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                </li>
                {% endfor %}
            </ul>
        </div>
    {% else %}
        <div class="alert alert-light border">Události se zobrazí po akci s objednávkou výše.</div>
    {% endif %}

    <p class="text-muted"><small><code>Order::place()</code> zaznamená <code>OrderPlaced</code>, <code>addItem()</code> <code>OrderItemAdded</code> a <code>confirm()</code> <code>OrderConfirmed</code>. Konstruktor událost nikdy nezaznamenává: sestavení agregátu z uložených dat by jinak znovu ohlásilo jeho vznik.</small></p>

    <hr class="my-5">
    <h2>Doménová služba</h2>
    <p>Pravidlo „doprava zdarma pro VIP zákazníky a objednávky s pěti a více položkami“ čte data dvou agregátů, <code>Customer</code> a <code>Order</code>. Nepatří ani jednomu z nich, a proto ho drží <code>ShippingFeeService</code> – bez stavu a bez repozitáře.</p>

    {% if feeResult %}
        <div class="alert alert-success">
            {{ feeResult.lines }} {{ feeResult.lines == 1 ? 'položka' : (feeResult.lines < 5 ? 'položky' : 'položek') }}, {{ feeResult.vip ? 'VIP zákazník' : 'běžný zákazník' }}: dopravné <strong>{{ fmt.money(feeResult.fee) }}</strong>
        </div>
    {% endif %}

    <form method="post" data-turbo="false" class="row g-2 align-items-center mb-3">
        <input type="hidden" name="action" value="shipping_fee">
        <div class="col-auto"><label class="col-form-label" for="lines">Počet položek</label></div>
        <div class="col-auto"><input type="number" id="lines" name="lines" value="2" min="1" max="10" class="form-control" style="width:90px"></div>
        <div class="col-auto form-check ms-2">
            <input type="checkbox" id="vip" name="vip" value="1" class="form-check-input">
            <label for="vip" class="form-check-label">VIP zákazník</label>
        </div>
        <div class="col-auto"><button class="btn btn-primary">ShippingFeeService::feeFor()</button></div>
    </form>

    <pre class="bg-light p-3 rounded small">final class ShippingFeeService
{
    public function feeFor(Order $order, Customer $customer): Money
    {
        $freeShipping = $customer-&gt;isVip()
            || count($order-&gt;items()) &gt;= self::FREE_SHIPPING_FROM_ITEMS;

        return $freeShipping
            ? Money::zero(Currency::CZK)
            : new Money(self::FLAT_FEE_CENTS, Currency::CZK);
    }
}</pre>

    <nav class="d-flex justify-content-between mt-5 pt-3 border-top">
        {% if prev_route is defined and prev_route %}
            <a href="{{ path(prev_route) }}">← {{ prev_title }}</a>
        {% else %}<span></span>{% endif %}
        {% if next_route is defined and next_route %}
            <a href="{{ path(next_route) }}">{{ next_title }} →</a>
        {% else %}<span></span>{% endif %}
    </nav>
</div>
{% endblock %}
