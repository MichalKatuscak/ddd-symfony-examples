{% extends 'base.html.twig' %}
{% block title %}Ukázka: Migrace z CRUD na DDD{% endblock %}
{% block body %}
<div class="container mt-4">
    <div class="alert alert-info">
        Tato ukázka patří ke kapitole
        <a href="https://ddd-v-symfony.katuscak.cz/migrace-z-crud"><strong>Migrace z CRUD architektury na DDD</strong></a>
    </div>
    <nav class="mb-3"><a href="{{ path('examples_index') }}">← Zpět na přehled</a></nav>
    <h1>Ukázka: User před migrací a po ní</h1>

    {% if dddResult %}<div class="alert alert-success">{{ dddResult }}</div>{% endif %}
    {% if dddError %}<div class="alert alert-danger">{{ dddError }}</div>{% endif %}
    {% if crudResult %}<div class="alert alert-warning">{{ crudResult }}</div>{% endif %}

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 border-danger">
                <div class="card-header bg-danger text-white"><strong>Před: anemická CRUD entita</strong></div>
                <div class="card-body">
                    <pre class="bg-light p-3 rounded small"><code>$user = new User();
$user->setEmail($email);
$user->setStatus('pending_verification');
// Stav je řetězec, přechody nehlídá nikdo:
$user->setStatus('aktivni');</code></pre>
                    <form method="post" data-turbo="false" class="mb-2">
                        <input type="hidden" name="action" value="crud_status">
                        <button class="btn btn-warning w-100">setStatus('aktivni') – projde</button>
                    </form>
                    <form method="post" data-turbo="false">
                        <input type="hidden" name="action" value="crud_activate_twice">
                        <button class="btn btn-warning w-100">Aktivace dvakrát – projde</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 border-success">
                <div class="card-header bg-success text-white"><strong>Po: doménový agregát User</strong></div>
                <div class="card-body">
                    <pre class="bg-light p-3 rounded small"><code>$user = User::register(
    UserId::generate(), new UserName($name),
    Email::fromUserInput($email),
    HashedPassword::fromPlainText($password),
);
$user->activate($token); // PendingVerification → Active</code></pre>
                    <form method="post" data-turbo="false" class="mb-2">
                        <input type="hidden" name="action" value="ddd_register">
                        <button class="btn btn-success w-100">User::register() – stav a události</button>
                    </form>
                    <form method="post" data-turbo="false" class="mb-2">
                        <input type="hidden" name="action" value="ddd_forbidden">
                        <button class="btn btn-outline-danger w-100">E-mail z mailinator.com → ForbiddenEmailDomainException</button>
                    </form>
                    <form method="post" data-turbo="false">
                        <input type="hidden" name="action" value="ddd_activate_twice">
                        <button class="btn btn-outline-danger w-100">Aktivace dvakrát → UserAlreadyActivatedException</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-secondary">
                <div class="card-header"><strong>Anti-Corruption Layer: legacy řádek → agregát</strong></div>
                <div class="card-body">
                    <p class="mb-2"><code>LegacyUserTranslator</code> překládá stav vyjmenovaně a agregát rekonstituuje –
                        datum registrace i token zůstávají z legacy řádku a žádná událost nevzniká.</p>
                    <form method="post" data-turbo="false" class="d-inline">
                        <input type="hidden" name="action" value="acl_translate">
                        <button class="btn btn-secondary">Stav „banned“ → Blocked</button>
                    </form>
                    <form method="post" data-turbo="false" class="d-inline">
                        <input type="hidden" name="action" value="acl_unknown">
                        <button class="btn btn-outline-secondary">Neznámý stav → UnmappableLegacyStatusException</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <nav class="d-flex justify-content-between mt-5 pt-3 border-top">
        {% if prev_route is defined and prev_route %}
            <a href="{{ path(prev_route) }}">← {{ prev_title }}</a>
        {% else %}<span></span>{% endif %}
        {% if next_route is defined and next_route %}
            <a href="{{ path(next_route) }}">{{ next_title }} →</a>
        {% else %}<span></span>{% endif %}
    </nav>
</div>
{% endblock %}
