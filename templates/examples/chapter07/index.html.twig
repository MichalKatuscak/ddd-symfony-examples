{% extends 'base.html.twig' %}
{% block title %}Ukázka: Ságy a Process Managery{% endblock %}
{% block body %}
<div class="container mt-4">
    <div class="alert alert-info">
        Tato ukázka patří ke kapitole
        <a href="https://ddd-v-symfony.katuscak.cz/sagy-a-process-managery"><strong>Ságy a Process Managery</strong></a>
    </div>
    <nav class="mb-3"><a href="{{ path('examples_index') }}">← Zpět na přehled</a></nav>
    <h1>Ukázka: orchestrovaná sága s kompenzacemi</h1>
    <p><code>OrderProcessManager</code> reaguje na události z kontextů Payment, Warehouse a Shipping
       a podle nich posílá další příkaz. Sám stav objednávky nemění – posílá
       <code>MarkOrderPaid</code>, <code>ShipOrder</code> nebo <code>CancelOrderCommand</code>.
       Když krok selže, vrátí hotové kroky kompenzacemi.</p>

    <form method="post" data-turbo="false" class="mb-4">
        <div class="row g-3 mb-3">
            <div class="col-auto">
                <div class="form-check">
                    <input type="checkbox" name="payment_fails" value="1" id="payment_fails" class="form-check-input">
                    <label for="payment_fails" class="form-check-label">Platba selže (není co kompenzovat)</label>
                </div>
            </div>
            <div class="col-auto">
                <div class="form-check">
                    <input type="checkbox" name="stock_fails" value="1" id="stock_fails" class="form-check-input">
                    <label for="stock_fails" class="form-check-label">Zboží není skladem (vrací se platba)</label>
                </div>
            </div>
        </div>
        <button class="btn btn-primary">Odeslat objednávku</button>
    </form>

    {% if result is not null %}
        {% set saga = result.saga %}
        <h3>
            Sága:
            {% if saga.status.value == 'completed' %}
                <span class="badge bg-success">completed</span>
            {% elseif saga.status.value == 'failed' %}
                <span class="badge bg-danger">failed</span>
            {% elseif saga.status.value == 'compensating' %}
                <span class="badge bg-warning text-dark">compensating</span>
            {% else %}
                <span class="badge bg-secondary">{{ saga.status.value }}</span>
            {% endif %}
        </h3>

        <table class="table table-sm w-auto">
            <tbody>
                <tr><th>Objednávka</th><td><code>{{ result.orderId|slice(0, 8) }}…</code></td></tr>
                <tr><th>Stav objednávky</th><td><span class="badge bg-secondary">{{ result.order.status.value }}</span></td></tr>
                <tr><th>Zámek ságy</th><td>{{ result.order.isLockedBySaga ? 'drží' : 'uvolněn' }}</td></tr>
                <tr><th>Hotové kroky</th><td>
                    {% for step in saga.context.completedSteps %}
                        <code>{{ step }}</code>{% if not loop.last %} → {% endif %}
                    {% else %}
                        <span class="text-muted">žádné</span>
                    {% endfor %}
                </td></tr>
                <tr><th>Rezervace skladu</th><td>{{ result.stockReserved ? 'drží se' : 'žádná' }}</td></tr>
                {% if saga.context.shipmentId is defined %}
                    <tr><th>Zásilka</th><td><code>{{ saga.context.shipmentId|slice(0, 8) }}…</code>{{ result.shipmentCancelled ? ' (zrušena)' : '' }}</td></tr>
                {% endif %}
            </tbody>
        </table>
    {% endif %}

    <hr>
    <h3>Jak to funguje</h3>
    <ol>
        <li><code>OrderPlacedIntegrationEvent</code> založí ságu ve stavu <code>awaiting_payment</code>
            a odešle <code>ChargeCustomer</code>.</li>
        <li><code>PaymentSucceeded</code> posune ságu do <code>awaiting_stock_reservation</code>,
            odešle <code>MarkOrderPaid</code> a <code>ReserveStock</code>.</li>
        <li><code>StockReserved</code> vede na <code>CreateShipment</code>, <code>ShipmentCreated</code>
            ságu dokončí, uvolní zámek a odešle <code>ShipOrder</code>.</li>
    </ol>
    <p>Selhání platby ságu rovnou ukončí a objednávku zruší – nic se nestalo, nic se nevrací.
       Selhání skladu přijde až po platbě: sága přejde do <code>compensating</code>, odešle
       <code>RefundCustomer</code> a do <code>failed</code> přejde až po <code>RefundSucceeded</code>.
       Storno zvenčí vrací hotové kroky v opačném pořadí: <code>CancelShipment</code>,
       <code>ReleaseStock</code>, <code>RefundCustomer</code>.</p>

    <pre class="bg-light p-3 rounded"><code>// OrderProcessManager::onPaymentSucceeded()
if (!$state-&gt;applyPaymentSucceeded((string) $event-&gt;eventId)) {
    return; // opakované doručení – příkazy se podruhé neodešlou
}
$this-&gt;commandBus-&gt;dispatch(new MarkOrderPaid(orderId: $event-&gt;orderId));
$this-&gt;commandBus-&gt;dispatch(new ReserveStock(orderId: $event-&gt;orderId));</code></pre>

    <nav class="d-flex justify-content-between mt-5 pt-3 border-top">
        {% if prev_route is defined and prev_route %}
            <a href="{{ path(prev_route) }}">← {{ prev_title }}</a>
        {% else %}<span></span>{% endif %}
        {% if next_route is defined and next_route %}
            <a href="{{ path(next_route) }}">{{ next_title }} →</a>
        {% else %}<span></span>{% endif %}
    </nav>
</div>
{% endblock %}
