{% extends 'base.html.twig' %}
{% block title %}Ukázka: Event Sourcing{% endblock %}
{% block body %}
<div class="container mt-4">
    <div class="alert alert-info">
        Tato ukázka patří ke kapitole
        <a href="https://ddd-v-symfony.katuscak.cz/event-sourcing"><strong>Event Sourcing v DDD a Symfony</strong></a>
    </div>
    <nav class="mb-3"><a href="{{ path('examples_index') }}">← Zpět na přehled</a></nav>
    <h1>Ukázka: Event Sourcing</h1>
    <p>Stav objednávky se neukládá jako řádek. Repozitář načte event stream přes
       <code>loadStream()</code> a agregát ho přehraje metodami <code>apply*()</code>.</p>

    {% if result %}<div class="alert alert-success">{{ result }}</div>{% endif %}
    {% if error %}<div class="alert alert-warning">{{ error }}</div>{% endif %}

    <div class="row g-4">
        <div class="col-md-5">
            <h3>Akce</h3>
            <form method="post" data-turbo="false" class="card p-3 mb-3">
                <input type="hidden" name="action" value="place">
                <div class="row g-2 mb-2">
                    <div class="col"><label class="form-label small" for="place_qty">Kusů</label><input type="number" id="place_qty" name="quantity" value="1" min="1" class="form-control"></div>
                    <div class="col"><label class="form-label small" for="place_price">Cena za kus (Kč)</label><input type="number" id="place_price" name="price" value="599" min="0" class="form-control"></div>
                </div>
                <button class="btn btn-primary w-100">Nová objednávka s položkou</button>
            </form>

            {% if orderId %}
                <p class="small text-muted">Pracujete s objednávkou <code>{{ orderId|slice(0, 8) }}…</code></p>
                <form method="post" data-turbo="false" class="card p-3 mb-2">
                    <input type="hidden" name="action" value="add_item">
                    <input type="hidden" name="order_id" value="{{ orderId }}">
                    <div class="row g-2 mb-2">
                        <div class="col"><input type="number" name="quantity" value="2" min="1" class="form-control" aria-label="Kusů"></div>
                        <div class="col"><input type="number" name="price" value="150" min="0" class="form-control" aria-label="Cena za kus"></div>
                    </div>
                    <button class="btn btn-outline-primary w-100">Přidat položku (OrderItemAdded)</button>
                </form>
                {% for action, label in {
                    'confirm': 'Potvrdit (OrderConfirmed)',
                    'ship': 'Odeslat (OrderShipped)',
                    'conflict': 'Dva souběžné zápisy do téže verze'
                } %}
                    <form method="post" data-turbo="false" class="mb-2">
                        <input type="hidden" name="action" value="{{ action }}">
                        <input type="hidden" name="order_id" value="{{ orderId }}">
                        <button class="btn {{ action == 'conflict' ? 'btn-outline-danger' : 'btn-outline-secondary' }} w-100">{{ label }}</button>
                    </form>
                {% endfor %}
            {% endif %}
        </div>

        <div class="col-md-7">
            <h3>Event stream</h3>
            {% if stream is empty %}
                <p class="text-muted">Založte objednávku a zobrazí se její události.</p>
            {% else %}
                <p>Stav po přehrání: <span class="badge bg-secondary">{{ order.status.value }}</span>,
                   verze streamu {{ order.version }}.</p>
                <table class="table table-sm">
                    <thead><tr><th>version</th><th>event_type</th><th>occurred_on</th></tr></thead>
                    <tbody>
                    {% for envelope in stream %}
                        <tr>
                            <td>{{ envelope.version }}</td>
                            <td><code>{{ envelope.eventType }}</code></td>
                            <td class="small">{{ envelope.occurredOn }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>

    <hr class="my-5">
    <h2>Projekce <code>ch06_order_summary</code></h2>
    <p>Read model postavený z událostí. Pro čtení nepotřebuje přehrávat agregát.</p>
    {% if summaries is not empty %}
        <table class="table table-sm">
            <thead><tr><th>Objednávka</th><th>Stav</th><th>Položek</th><th>Celkem</th><th>Zásilka</th></tr></thead>
            <tbody>
            {% for s in summaries %}
                <tr>
                    <td><code>{{ s.order_id|slice(0, 8) }}…</code></td>
                    <td><span class="badge bg-secondary">{{ s.status }}</span></td>
                    <td>{{ s.item_count }}</td>
                    <td>{{ (s.total_amount / 100)|number_format(2, ',', ' ') }} Kč</td>
                    <td>{{ s.tracking_no ?? '–' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="text-muted">Zatím žádné objednávky.</p>
    {% endif %}

    <nav class="d-flex justify-content-between mt-5 pt-3 border-top">
        {% if prev_route is defined and prev_route %}
            <a href="{{ path(prev_route) }}">← {{ prev_title }}</a>
        {% else %}<span></span>{% endif %}
        {% if next_route is defined and next_route %}
            <a href="{{ path(next_route) }}">{{ next_title }} →</a>
        {% else %}<span></span>{% endif %}
    </nav>
</div>
{% endblock %}
