{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}Ukázka: Implementace v Symfony 8{% endblock %}
{% block body %}
<div class="container mt-4">
    <div class="alert alert-info">
        Tato ukázka patří ke kapitole
        <a href="https://ddd-v-symfony.katuscak.cz/implementace-v-symfony"><strong>Implementace v Symfony 8</strong></a>
    </div>
    <nav class="mb-3"><a href="{{ path('examples_index') }}">← Zpět na přehled</a></nav>
    <h1>Ukázka: registrace uživatele od kontroleru po databázi</h1>
    <p>
        Formulář skládá command <code>RegisterUser</code>, command bus ho předá
        <code>RegisterUserHandler</code>, ten založí agregát <code>User</code>
        přes <code>User::register()</code> a uloží ho přes Doctrine.
        Hodnotové objekty <code>UserId</code> a <code>Email</code> převádějí custom typy,
        <code>UserName</code> a <code>HashedPassword</code> jsou embeddable.
    </p>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="row g-4">
        <div class="col-md-5">
            <h3>Registrace</h3>
            {{ form_start(form, {attr: {'data-turbo': 'false'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.email) }}
                {{ form_row(form.password) }}
                <button type="submit" class="btn btn-primary">Registrovat</button>
            {{ form_end(form) }}
            <p class="text-muted small mt-3">
                Zkuste stejný e-mail dvakrát, klidně s velkými písmeny. <code>Email::fromUserInput()</code>
                adresu normalizuje a druhý zápis zastaví unikátní index v databázi. Handler
                výjimku <code>UniqueConstraintViolationException</code> přeloží na
                <code>DuplicateEmailException</code>.
            </p>
        </div>

        <div class="col-md-7">
            <h3>Profil (<code>GetUserProfile</code>)</h3>
            {% if profile %}
                <table class="table table-sm">
                    <tbody>
                        <tr><th>ID</th><td><code>{{ profile.id }}</code></td></tr>
                        <tr><th>Jméno</th><td>{{ profile.name }}</td></tr>
                        <tr><th>E-mail</th><td>{{ profile.email }}</td></tr>
                        <tr><th>Registrace</th><td>{{ profile.createdAt|date('j. n. Y H:i:s') }}</td></tr>
                    </tbody>
                </table>
                <p class="text-muted small">
                    Query handler čte přes repozitář agregátu a ven pouští jen DTO
                    <code>UserProfile</code>, ne agregát ani hodnotové objekty.
                </p>
            {% else %}
                <p class="text-muted">Po registraci se zde zobrazí profil nového uživatele.</p>
            {% endif %}

            {% for payload in app.flashes('event') %}
                <h4 class="mt-4">Doručená událost <code>UserRegistered</code></h4>
                <pre class="bg-light p-3 rounded small">{{ payload }}</pre>
                <p class="text-muted small">
                    Událost nese primitivy: odebírá ji i kontext Identity. Handler ji odeslal
                    až po <code>flush()</code>, posluchač z ní poskládal přesměrování na profil
                    bez dotazu do <code>UserRepository</code>.
                </p>
            {% endfor %}
        </div>
    </div>

    <hr class="my-5">
    <h2>Enum pro stav objednávky</h2>
    <p>
        <code>OrderStatus</code> je backed enum a přechodová pravidla drží v metodě
        <code>allowedTransitions()</code>. Tabulka se generuje přímo z enumu.
    </p>
    <table class="table table-sm w-auto">
        <thead><tr><th>Stav</th><th>Povolené přechody</th></tr></thead>
        <tbody>
        {% for status in statuses %}
            <tr>
                <td><code>{{ status.value }}</code></td>
                <td>
                    {% for target in status.allowedTransitions() %}
                        <span class="badge bg-secondary">{{ target.value }}</span>
                    {% else %}
                        <span class="text-muted">koncový stav</span>
                    {% endfor %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <nav class="d-flex justify-content-between mt-5 pt-3 border-top">
        {% if prev_route is defined and prev_route %}
            <a href="{{ path(prev_route) }}">← {{ prev_title }}</a>
        {% else %}<span></span>{% endif %}
        {% if next_route is defined and next_route %}
            <a href="{{ path(next_route) }}">{{ next_title }} →</a>
        {% else %}<span></span>{% endif %}
    </nav>
</div>
{% endblock %}
